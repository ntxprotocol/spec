{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ntxprotocol.com/schemas/0.1/error.schema.json",
  "title": "error (any endpoint)",
  "type": "object",
  "required": ["op", "code"],
  "properties": {
    "op": { "const": "error" },
    "code": { "type": "string", "minLength": 1, "maxLength": 64 },
    "message": { "type": "string", "maxLength": 1024 }
  }
}
