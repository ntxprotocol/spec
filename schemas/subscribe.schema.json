{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ntxprotocol.com/schemas/0.1/subscribe.schema.json",
  "title": "subscribe (receiver to source)",
  "type": "object",
  "required": ["op", "ntx", "receiver"],
  "properties": {
    "op": { "const": "subscribe" },
    "ntx": { "$ref": "defs.schema.json#/$defs/version" },
    "receiver": { "$ref": "defs.schema.json#/$defs/endpoint" },
    "channels": { "$ref": "defs.schema.json#/$defs/channels" },
    "pairing": { "$ref": "#/$defs/pairingProof" }
  },
  "$defs": {
    "pairingProof": {
      "description": "pairing must be an object and proof a string (clause 13.4). A missing proof is answered with pairing_required, and a proof string that is not 44 characters of padded Base64 with pairing_failed, so the schema does not check the string itself.",
      "type": "object",
      "properties": { "proof": { "type": "string" } }
    }
  }
}
